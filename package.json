{
  "name": "classics-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Classics Library — a bilingual (Chinese / English) personal library of classic books, ideas and mental models.",
  "scripts": {
    "build": "node src/build.mjs",
    "serve": "node src/serve.mjs",
    "dev": "node src/build.mjs && node src/serve.mjs",
    "check": "node src/check.mjs",
    "ingest": "node src/ingest-books.mjs",
    "books:existing": "node src/ingest-books.mjs --existing",
    "sources:anzm": "node src/anzm-source.mjs",
    "sources:anzm:brief": "node src/anzm-source.mjs --brief",
    "covers": "node src/covers-check.mjs",
    "covers:ingest": "node src/covers-ingest.mjs",
    "covers:list": "node src/gen-covers-md.mjs",
    "covers:todo": "node src/gen-covers-todo.mjs",
    "covers:match-test": "node scripts/covers-match-selftest.mjs",
    "covers:publish": "node scripts/covers-publish.mjs",
    "verify:covers:live": "node scripts/verify-covers-live.mjs",
    "content:brief": "node src/articles-brief.mjs",
    "articles:brief": "node src/articles-brief.mjs",
    "verify:my-reading": "node scripts/verify-my-reading.mjs",
    "verify:my-reading:live": "node scripts/verify-my-reading-live.mjs",
    "verify:search:live": "node scripts/verify-search-live.mjs",
    "sync:books": "node scripts/export-to-books.mjs",
    "sync:books:all": "node scripts/export-to-books.mjs --all",
    "trend:automation": "node scripts/automation-trend.mjs",
    "trend:automation:strict": "node scripts/automation-trend.mjs --strict"
  },
  "engines": {
    "node": ">=20"
  }
}
